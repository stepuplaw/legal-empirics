  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "geoid",
      "description": "Census GEOID: 12 followed by the county FIPS code, or 12 followed by the place FIPS code"
    },
    {
      "@type": "PropertyValue",
      "name": "name",
      "description": "jurisdiction name without its type suffix"
    },
    {
      "@type": "PropertyValue",
      "name": "type",
      "description": "county | city | town | village, taken from the Census, never from the codifier"
    },
    {
      "@type": "PropertyValue",
      "name": "county",
      "description": "the county the jurisdiction sits in; for a county row, itself"
    },
    {
      "@type": "PropertyValue",
      "name": "counties",
      "description": "every county the place falls in, pipe separated, largest population share first"
    },
    {
      "@type": "PropertyValue",
      "name": "population",
      "description": "Census population estimate, vintage 2024"
    },
    {
      "@type": "PropertyValue",
      "name": "code_status",
      "description": "online-html | online-pdf-only | no-online-code | unknown"
    },
    {
      "@type": "PropertyValue",
      "name": "publisher",
      "description": "municode | american-legal | general-code | code-publishing | self-hosted | none | unknown"
    },
    {
      "@type": "PropertyValue",
      "name": "code_url",
      "description": "the verified URL of the code of ordinances; empty where no code is online"
    },
    {
      "@type": "PropertyValue",
      "name": "publisher_client_id",
      "description": "the codifier's own identifier for this jurisdiction, where it has one"
    },
    {
      "@type": "PropertyValue",
      "name": "code_product_id",
      "description": "Municode product id for the code of ordinances; the key to its table of contents"
    },
    {
      "@type": "PropertyValue",
      "name": "codified_through",
      "description": "date of the most recent ordinance included in the code, as the publisher states it"
    },
    {
      "@type": "PropertyValue",
      "name": "code_last_updated",
      "description": "date the publisher last posted an update online"
    },
    {
      "@type": "PropertyValue",
      "name": "pdf_available",
      "description": "1 where the publisher offers the code as a downloadable PDF"
    },
    {
      "@type": "PropertyValue",
      "name": "pending_ordinances_count",
      "description": "adopted ordinances awaiting codification, per the publisher; null outside Municode"
    },
    {
      "@type": "PropertyValue",
      "name": "official_status",
      "description": "official | unofficial | unstated -- recorded only where the page says so, never inferred"
    },
    {
      "@type": "PropertyValue",
      "name": "source",
      "description": "municode-api | browser | manual -- how this row was resolved"
    },
    {
      "@type": "PropertyValue",
      "name": "source_checked_date",
      "description": "the date this row was checked; codifier contracts move, so the date is part of the claim"
    },
    {
      "@type": "PropertyValue",
      "name": "notes",
      "description": "free text, used mainly for jurisdictions no codifier carries"
    },
    {
      "@type": "PropertyValue",
      "name": "statement",
      "description": "the row written as one self-contained English sentence, so it can be retrieved, quoted and checked on its own"
    }
  ],
  "spatialCoverage": {
    "@type": "Place",
    "name": "Florida, United States"
  },
  "temporalCoverage": "2026"
}