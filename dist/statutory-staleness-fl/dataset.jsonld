    },
    {
      "@type": "DataDownload",
      "encodingFormat": "application/vnd.apache.parquet",
      "contentUrl": "https://stepuplaw.com/research/statutory-staleness-fl/statutory-staleness-fl.parquet",
      "contentSize": "4408320",
