  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "oid",
      "description": "CourtListener opinion id"
    },
    {
      "@type": "PropertyValue",
      "name": "cid",
      "description": "CourtListener cluster id"
    },
    {
      "@type": "PropertyValue",
      "name": "name",
      "description": "case name as reported"
    },
    {
      "@type": "PropertyValue",
      "name": "court",
      "description": "CourtListener court id"
    },
    {
      "@type": "PropertyValue",
      "name": "year",
      "description": "year the decision was filed"
    },
    {
      "@type": "PropertyValue",
      "name": "cites",
      "description": "times the decision has been cited, per CourtListener"
    },
    {
      "@type": "PropertyValue",
      "name": "section",
      "description": "Florida Statutes section construed, e.g. 732.615"
    },
    {
      "@type": "PropertyValue",
      "name": "last_amended",
      "description": "most recent amendment year in the section history trail"
    },
    {
      "@type": "PropertyValue",
      "name": "amendments_since",
      "description": "count of amendments after the decision"
    },
    {
      "@type": "PropertyValue",
      "name": "gap_years",
      "description": "years between the decision and the most recent later amendment"
    },
    {
      "@type": "PropertyValue",
      "name": "exposed",
      "description": "1 where the section was amended after the decision; an UPPER BOUND, not a finding of abrogation"
    },
    {
      "@type": "PropertyValue",
      "name": "tier",
      "description": "amendment-screen | text-diff -- text-diff is only available where an edition at or before the decision year is held"
    },
    {
      "@type": "PropertyValue",
      "name": "text_changed",
      "description": "1 where the operative text differs between the edition in force at the decision and the current edition; null outside the text-diff tier"
    },
    {
      "@type": "PropertyValue",
      "name": "similarity",
      "description": "SequenceMatcher ratio between the two editions operative text, history trail excluded"
    },
    {
      "@type": "PropertyValue",
      "name": "edition_at_decision",
      "description": "the statute edition used as the baseline for the diff"
    },
    {
      "@type": "PropertyValue",
      "name": "sentence",
      "description": "the sentence in which the section was construed, verbatim"
    },
    {
      "@type": "PropertyValue",
      "name": "statement",
      "description": "the row written as one self-contained English sentence"
    }
  ]
}