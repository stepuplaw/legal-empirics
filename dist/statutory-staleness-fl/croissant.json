          "source": {
            "fileObject": {
              "@id": "statutory-staleness-fl.csv"
            },
            "extract": {
              "column": "amendments_since"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rows/gap_years",
          "name": "gap_years",
          "description": "years between the decision and the most recent later amendment",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "statutory-staleness-fl.csv"
            },
            "extract": {
              "column": "gap_years"
            }
