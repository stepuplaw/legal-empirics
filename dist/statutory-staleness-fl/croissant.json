            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rows/year",
          "name": "year",
          "description": "year the decision was filed",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "statutory-staleness-fl.csv"
            },
            "extract": {
