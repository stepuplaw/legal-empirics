  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "statutory_staleness_fl",
  "description": "One row per (decision, statutory section) pair where a Florida appellate court construed the meaning of a Florida statute, with whether that section has been amended since the decision and, where two editions of the code are held, whether the operative text actually changed. A citator reports whether a case was overruled by another case; it is far weaker on the other way a holding dies, which is that the legislature amended the statute and no court has had occasion to say so. This dataset measures that gap directly.",
  "url": "https://stepuplaw.com/research/statutory-staleness-fl/",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "version": "2026-09-02",
  "keywords": [
    "statutory interpretation",
    "abrogation",
    "citator",
    "legal research",
    "empirical legal studies",
    "Florida",
    "statutory currency",
    "legal AI evaluation"
  ],
  "creator": {
    "@type": "sc:Person",
    "name": "Kevin D. Klagge",
    "sameAs": "https://orcid.org/0009-0002-1385-8498"
  },
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "statutory-staleness-fl.csv",
      "name": "statutory-staleness-fl.csv",
      "description": "The dataset as a single UTF-8 CSV with a header row.",
      "contentUrl": "https://stepuplaw.com/research/statutory-staleness-fl/statutory-staleness-fl.csv",
      "encodingFormat": "text/csv",
      "sha256": "a1a250ac2c4233750ff025b2586609bc5b54a26db2d251afe6efbcd6a4ef79b9"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "rows",
      "name": "rows",
      "description": "Statutory Staleness in Florida Appellate Construction Holdings",
