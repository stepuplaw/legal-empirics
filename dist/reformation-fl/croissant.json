  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "reformation_fl",
  "description": "Every Florida state appellate decision litigating the reformation of a legal instrument -- will, trust, deed, contract or insurance policy -- with the instrument type, the kind of drafting error alleged, the outcome, and which statutory regime was in force. Florida authorised trust reformation in 2007 (s. 736.0415) and will reformation in 2011 (s. 732.615); before those dates the remedy rested on equity, and for wills was unavailable entirely. The dataset makes that break observable within one jurisdiction.",
  "url": "https://stepuplaw.com/research/reformation-fl/",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "version": "2026-09-01",
  "keywords": [
    "reformation",
    "scrivener's error",
    "wills",
    "trusts",
    "deeds",
    "legal drafting",
    "empirical legal studies",
    "Florida",
    "preventive law"
  ],
  "creator": {
    "@type": "sc:Person",
    "name": "Kevin D. Klagge",
    "sameAs": "https://orcid.org/0009-0002-1385-8498"
  },
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "reformation-fl.csv",
      "name": "reformation-fl.csv",
      "description": "The dataset as a single UTF-8 CSV with a header row.",
      "contentUrl": "https://stepuplaw.com/research/reformation-fl/reformation-fl.csv",
      "encodingFormat": "text/csv",
      "sha256": "94410e32f9e6af8a12a9456ad953d273782939be1263ad1bd91939aa85419602"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "rows",
      "name": "rows",
      "description": "Florida Reformation of Instruments, 1853-2026",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "rows/oid",
          "name": "oid",
          "description": "CourtListener opinion id",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "reformation-fl.csv"
            },
            "extract": {
              "column": "oid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rows/cid",
          "name": "cid",
          "description": "CourtListener cluster id; one decision may hold several opinions",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "reformation-fl.csv"
            },
            "extract": {
              "column": "cid"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rows/name",
          "name": "name",
          "description": "case name as reported",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "reformation-fl.csv"
            },
            "extract": {
              "column": "name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rows/court",
          "name": "court",
          "description": "CourtListener court id (fla = Supreme Court of Florida, fladistctapp = District Courts of Appeal)",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "reformation-fl.csv"
            },
            "extract": {
              "column": "court"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rows/year",
          "name": "year",
          "description": "year the decision was filed",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "reformation-fl.csv"
            },
            "extract": {
              "column": "year"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "rows/cites",
          "name": "cites",
          "description": "times the decision has been cited, per CourtListener",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "reformation-fl.csv"
            },
            "extract": {
              "column": "cites"
            }
